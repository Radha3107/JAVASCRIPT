<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Grading System</title>
    <style>
        /* Modern, clean aesthetic layout styling */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            background-color: #ffffff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 450px;
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #2c3e50;
        }

        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #34495e;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 2px solid #bdc3c7;
            border-radius: 6px;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        input:focus {
            outline: none;
            border-color: #3498db;
        }

        /* Error state styling for fields failing validation */
        .error-message {
            color: #e74c3c;
            font-size: 13px;
            margin-top: 5px;
            display: none;
        }

        input.invalid {
            border-color: #e74c3c;
            background-color: #fdf2f2;
        }

        button {
            width: 100%;
            padding: 14px;
            background-color: #2ecc71;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        button:hover {
            background-color: #27ae60;
        }

        /* Output presentation block styling */
        .result-box {
            margin-top: 25px;
            padding: 15px;
            border-radius: 6px;
            background-color: #eef2f3;
            border-left: 5px solid #3498db;
            display: none;
        }

        .result-box.show {
            display: block;
        }

        .result-item {
            margin-bottom: 8px;
            font-size: 16px;
            color: #2c3e50;
        }

        .result-item span {
            font-weight: bold;
            color: #111;
        }

        .grade-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            color: white;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Student Grading Portal</h2>
    
    <form id="gradingForm" novalidate>
        <!-- Name Field with Custom Validation Layout -->
        <div class="form-group">
            <label for="studentName">Student Name</label>
            <input type="text" id="studentName" placeholder="Enter student's full name">
            <div class="error-message" id="nameError">Please enter a valid name (letters only, minimum 2 characters).</div>
        </div>

        <!-- Marks Field with Score Boundary Validation Layout -->
        <div class="form-group">
            <label for="studentMarks">Obtained Marks (0 - 100)</label>
            <input type="number" id="studentMarks" placeholder="Enter marks numeric value">
            <div class="error-message" id="marksError">Please enter a valid score between 0 and 100.</div>
        </div>

        <button type="submit">Calculate Grade</button>
    </form>

    <!-- UI placeholder card rendering results conditionally -->
    <div class="result-box" id="resultBox">
        <div class="result-item">Student: <span id="resName"></span></div>
        <div class="result-item">Score: <span id="resMarks"></span>/100</div>
        <div class="result-item">Assigned Grade: <span id="resGrade"></span></div>
        <div class="result-item">Performance Status: <span id="resStatus"></span></div>
    </div>
</div>

<script>
    document.getElementById('gradingForm').addEventListener('submit', function(event) {
        // Prevent default browser form reloading behavior
        event.preventDefault();

        // 1. DOM Element references
        const nameInput = document.getElementById('studentName');
        const marksInput = document.getElementById('studentMarks');
        
        const nameError = document.getElementById('nameError');
        const marksError = document.getElementById('marksError');
        const resultBox = document.getElementById('resultBox');

        // Extract and trim spaces from inputs
        const nameValue = nameInput.value.trim();
        const marksValue = marksInput.value.trim();

        // Reset previous form validation states
        let isValid = true;
        nameInput.classList.remove('invalid');
        marksInput.classList.remove('invalid');
        nameError.style.display = 'none';
        marksError.style.display = 'none';
        resultBox.classList.remove('show');

        // 2. Comprehensive Data Format & Boundary Form Validation Control Structures
        const nameRegex = /^[A-Za-z\s]{2,50}$/; 
        if (!nameRegex.test(nameValue)) {
            nameInput.classList.add('invalid');
            nameError.style.display = 'block';
            isValid = false;
        }

        const numericMarks = parseFloat(marksValue);
        if (marksValue === "" || isNaN(numericMarks) || numericMarks < 0 || numericMarks > 100) {
            marksInput.classList.add('invalid');
            marksError.style.display = 'block';
            isValid = false;
        }

        // Halt grading computation process if any error flags are active
        if (!isValid) return;

        // 3. Conditional Structures for the Grading System Logic
        let grade = "";
        let status = "";
        let badgeColor = "";

        if (numericMarks >= 90) {
            grade = "A+";
            status = "Excellent Performance!";
            badgeColor = "#2ecc71"; // green
        } else if (numericMarks >= 80) {
            grade = "A";
            status = "Very Good Job.";
            badgeColor = "#3498db"; // blue
        } else if (numericMarks >= 70) {
            grade = "B";
            status = "Good, keep improving.";
            badgeColor = "#f1c40f"; // yellow
        } else if (numericMarks >= 60) {
            grade = "C";
            status = "Satisfactory Performance.";
            badgeColor = "#e67e22"; // orange
        } else if (numericMarks >= 50) {
            grade = "D";
            status = "Passable, needs focus.";
            badgeColor = "#9b59b6"; // purple
        } else {
            grade = "F";
            status = "Failed. Academic remediation required.";
            badgeColor = "#e74c3c"; // red
        }

        // 4. Output Presentation Generation
        document.getElementById('resName').textContent = nameValue;
        document.getElementById('resMarks').textContent = numericMarks;
        
        // Render the grade code using a dynamic styled badge 
        const gradeSpan = document.getElementById('resGrade');
        gradeSpan.innerHTML = `<span class="grade-badge" style="background-color: ${badgeColor}">${grade}</span>`;
        
        document.getElementById('resStatus').textContent = status;

        // Display results container box
        resultBox.classList.add('show');
    });
</script>

</body>
</html>
